<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #000; padding: 20px; font-size: 12px; }
        .header { text-align: left; margin-bottom: 30px; }
        .header h1 { font-size: 18px; margin: 0; text-transform: uppercase; }
        .section-title { font-weight: bold; font-size: 14px; margin-top: 20px; margin-bottom: 10px; }
        .row { display: flex; justify-content: space-between; padding: 4px 0; }
        .indent { padding-left: 40px; }
        .bold { font-weight: bold; }
        .italic { font-style: italic; }
        .amount { text-align: right; width: 150px; }
        .highlight { background-color: #d9d9d9; padding: 5px 0; border-top: 1px solid #000; border-bottom: 2px solid #000; }
        .line-above { border-top: 1px solid #000; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { padding: 6px 0; text-align: left; }
        th { border-bottom: 2px solid #000; font-weight: bold; font-style: italic; }
        .td-amount { text-align: right; }
        .tfoot-row td { border-top: 1px solid #000; font-weight: bold; padding-top: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <h1><%= profile.business_name %></h1>
        <p>Financial Statement - Quarter <%= quarter %> <%= year %></p>
    </div>

    <div class="section-title">1. Income statement</div>
    <div class="row bold">
        <div>Fees Earned</div>
        <div class="amount"><%= formatNumber(totalIncome) %></div>
    </div>
    <div class="row bold">
        <div>Total Expense</div>
        <div class="amount">(<%= formatNumber(totalExpense) %>)</div>
    </div>
    <div class="row bold highlight" style="margin-top: 5px;">
        <div>Nett Profit</div>
        <div class="amount"><%= formatNumber(netProfit) %></div>
    </div>

    <br>

    <div class="section-title">2. Expense Statement</div>
    <table>
        <thead>
            <tr>
                <th>Category</th>
                <th class="td-amount">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% for(let cat in expenseDetails) { %>
                <tr style="border-bottom: 1px solid #eee;">
                    <td class="indent"><%= cat %></td>
                    <td class="td-amount"><%= formatNumber(expenseDetails[cat]) %></td>
                </tr>
            <% } %>
        </tbody>
        <tfoot>
            <tr class="tfoot-row">
                <td>Total Operating Expenses</td>
                <td class="td-amount"><%= formatNumber(totalExpense) %></td>
            </tr>
        </tfoot>
    </table>

    <br>

    <div class="section-title">3. Statement of Changes Equity</div>
    
    <div class="row">
        <div class="italic">Beginning of the year :</div>
        <div class="amount"><%= beginningEquity === 0 ? '-' : formatNumber(beginningEquity) %></div>
    </div>
    <br>
    
    <div class="row italic">
        <div>Change during years in Owners Equity :</div>
    </div>
    <div class="row indent">
        <div>+/+ Paid in Capital</div>
        <div class="amount"><%= formatNumber(paidInCapital) %></div>
    </div>
    <div class="row indent">
        <div>-/- Drawing</div>
        <div class="amount">(<%= formatNumber(Math.abs(drawing)) %>)</div>
    </div>
    <div class="row indent line-above" style="margin-top: 5px;">
        <div>+/+ Income from Operations</div>
        <div class="amount"><%= formatNumber(netProfit) %></div>
    </div>
    
    <br>
    <div class="row bold">
        <div>Ending of Year :</div>
        <div class="amount"><%= formatNumber(endingEquity) %></div>
    </div>
</body>
</html>