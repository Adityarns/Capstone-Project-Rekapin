<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Financial Statement - <%= profile.business_name %></title>
    <style>
        /* ── DASAR TYPOGRAPHY & LAYOUT ── */
        body { 
            font-family: 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif; 
            color: #111111; 
            padding: 10px; 
            font-size: 12px; 
            line-height: 1.5;
        }
        
        /* ── HEADER BISNIS ── */
        .header { 
            border-bottom: 2px solid #111111;
            padding-bottom: 15px;
            margin-bottom: 30px; 
        }
        .header h1 { 
            font-size: 20px; 
            font-weight: 700;
            margin: 0 0 4px 0; 
            text-transform: uppercase; 
            letter-spacing: 0.5px;
        }
        .header p {
            font-size: 12px;
            color: #555555;
            margin: 0;
            font-style: italic;
        }

        /* ── STRUKTUR TABEL AKUNTANSI STANDAR ── */
        .report-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 35px;
            table-layout: fixed;
        }
        .report-table th, .report-table td {
            padding: 6px 0;
            vertical-align: bottom;
        }
        .report-table th {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            border-bottom: 1px solid #111111;
            padding-bottom: 6px;
        }
        
        /* ── DETERMINASI LEBAR KOLOM (ALIGNED PERFECTLY) ── */
        .col-desc { width: 70%; text-align: left; }
        .col-amount { width: 30%; text-align: right; font-variant-numeric: tabular-nums; }
        
        /* ── VARIASI BARIS & INDENTASI ── */
        .section-header {
            font-size: 13px;
            font-weight: 700;
            padding-bottom: 8px;
            text-transform: capitalize;
        }
        .indent-1 { padding-left: 20px; }
        .indent-2 { padding-left: 40px; }
        .bold { font-weight: bold; }
        .italic { font-style: italic; }

        /* ── GARIS SYARAT AKUNTANSI (ACCOUNTING BORDERS) ── */
        .line-above {
            border-top: 1px solid #111111;
        }
        .final-total td {
            font-weight: bold;
            border-top: 1px solid #111111;
            border-bottom: 4px double #111111; /* Standar Double Underline Akuntansi */
            padding-top: 8px;
            padding-bottom: 4px;
        }
        .sub-total td {
            font-weight: bold;
            border-top: 1px solid #cccccc;
            padding-top: 6px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1><%= profile.business_name %></h1>
        <p>Financial Statement — Quarter <%= quarter %> Fiscal Year <%= year %></p>
    </div>

    <table class="report-table">
        <thead>
            <tr>
                <th class="col-desc">1. Income Statement</th>
                <th class="col-amount">Amount (IDR)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="col-desc indent-1">Gross Revenues / Fees Earned</td>
                <td class="col-amount"><%= formatNumber(totalIncome) %></td>
            </tr>
            <tr>
                <td class="col-desc indent-1">Total Operating Expenses</td>
                <td class="col-amount">(<%= formatNumber(totalExpense) %>)</td>
            </tr>
            <tr class="final-total">
                <td class="col-desc">Net Profit / (Loss)</td>
                <td class="col-amount"><%= formatNumber(netProfit) %></td>
            </tr>
        </tbody>
    </table>

    <table class="report-table">
        <thead>
            <tr>
                <th class="col-desc">2. Operating Expense Breakdown</th>
                <th class="col-amount">Amount (IDR)</th>
            </tr>
        </thead>
        <tbody>
            <% if (Object.keys(expenseDetails).length === 0) { %>
                <tr>
                    <td class="col-desc indent-1 italic" color="#888">No operating expenses recorded in this period.</td>
                    <td class="col-amount">-</td>
                </tr>
            <% } else { %>
                <% for(let cat in expenseDetails) { %>
                    <tr>
                        <td class="col-desc indent-1"><%= cat %></td>
                        <td class="col-amount"><%= formatNumber(expenseDetails[cat]) %></td>
                    </tr>
                <% } %>
            <% } %>
            <tr class="sub-total">
                <td class="col-desc">Total Operational Accumulation</td>
                <td class="col-amount"><%= formatNumber(totalExpense) %></td>
            </tr>
        </tbody>
    </table>

    <table class="report-table">
        <thead>
            <tr>
                <th class="col-desc">3. Statement of Changes Equity</th>
                <th class="col-amount">Amount (IDR)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="col-desc italic">Owner's Equity, Capital (Beginning of Period)</td>
                <td class="col-amount"><%= beginningEquity === 0 ? '-' : formatNumber(beginningEquity) %></td>
            </tr>
            <tr>
                <td class="col-desc bold" style="padding-top: 12px;">Changes in Owner's Equity Investment:</td>
                <td class="col-amount"></td>
            </tr>
            <tr>
                <td class="col-desc indent-1">(+) Capital Investment / Paid-in Capital</td>
                <td class="col-amount"><%= formatNumber(paidInCapital) %></td>
            </tr>
            <tr>
                <td class="col-desc indent-1">(-) Owner's Drawings / Prive Dues</td>
                <td class="col-amount">
                    <% if (Math.abs(drawing) === 0) { %>
                        -
                    <% } else { %>
                        (<%= formatNumber(Math.abs(drawing)) %>)
                    </thead>
                    <% } %>
                </td>
            </tr>
            <tr>
                <td class="col-desc indent-1">(+) Net Income from Current Operations</td>
                <td class="col-amount"><%= formatNumber(netProfit) %></td>
            </tr>
            <tr class="final-total">
                <td class="col-desc">Owner's Equity, Capital (End of Period)</td>
                <td class="col-amount"><%= formatNumber(endingEquity) %></td>
            </tr>
        </tbody>
    </table>

</body>
</html>